# ============================================================
# BoardingEdu Backend - Environment Template
#
# COPY THIS FILE TO `.env` IN THE SAME FOLDER AND FILL IN VALUES.
# NEVER COMMIT THE REAL `.env` FILE TO VERSION CONTROL.
# ============================================================

# ---- Django Core ----
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-REPLACE_WITH_RANDOM_50_CHAR_STRING

# Set to False in production.
DEBUG=True

# Comma-separated list; use * for local development only.
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ---- PostgreSQL (matches compose.yaml defaults for Docker local setup) ----
DB_NAME=boardingedu
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=localhost
DB_PORT=5432

# ---- Redis (Cache backend + Celery Broker / Result Backend) ----
# Redis DB 0 for cache and celery. For production, separate DB numbers.
REDIS_URL=redis://localhost:6379/0

# ---- Meilisearch (Full-text search engine) ----
# Hostname and master key. Leave master key empty during local development.
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# ---- CORS (Next.js Frontend Origins) ----
# Local Next.js default is http://localhost:3000
# Add production/preview origins for Vercel deploys.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
