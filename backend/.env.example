# ============================================================
# BoardingEdu Backend - Environment Template
#
# COPY THIS FILE TO `.env` IN THE SAME FOLDER AND FILL IN VALUES.
# NEVER COMMIT THE REAL `.env` FILE TO VERSION CONTROL.
# ============================================================

# ---- Django Core ----
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-REPLACE_WITH_RANDOM_50_CHAR_STRING

# Set to False in production.
DEBUG=True

# Comma-separated list; use * for local development only.
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ---- PostgreSQL ----
# Local Docker / compose default:
# DATABASE_URL=postgres://postgres:postgres123@localhost:5432/boardingedu
# Railway: reference the PostgreSQL service's DATABASE_URL.
DATABASE_URL= postgresql://postgres:BpZhNxUwLRqeZEiNnBGYoLsjOTqrDvPi@127.0.0.1:57220/railway
DATABASE_SSL_REQUIRE=false

# Legacy keys (unused when DATABASE_URL is set)
DB_NAME=boardingedu
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=localhost
DB_PORT=5432

# ---- Redis (Cache backend + Celery Broker / Result Backend) ----
# Redis DB 0 for cache and celery. For production, separate DB numbers.
REDIS_URL=redis://localhost:6379/0

# ---- Meilisearch (Full-text search engine) ----
# Hostname and master key. Leave master key empty during local development.
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# ---- Railway production checklist ----
# SECRET_KEY=          (required; generate a random key)
# DEBUG=False
# DATABASE_URL=        (from Railway PostgreSQL plugin — Reference Variable)
# DATABASE_SSL_REQUIRE=true
# ALLOWED_HOSTS=       (optional; .up.railway.app is allowed by default)
# CORS_ALLOWED_ORIGINS=https://www.boardingedu.com,https://boardingedu.com
# CSRF_TRUSTED_ORIGINS=https://www.boardingedu.com,https://boardingedu.com
# CLOUDFLARE_R2_*      (required for /media/schools/ image proxy)
# Used by DataScrapping/upload_cloudflare_r2.py
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=boardingedu-media
CLOUDFLARE_R2_PUBLIC_BASE=https://media.boardingeu.com/schools

# ---- CORS (Next.js Frontend Origins) ----
# Include the exact Vercel production origin; separate additional origins with commas.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
# Optional regexes for a controlled set of preview deployments, comma-separated.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-project-[a-z0-9-]+\\.vercel\\.app$
