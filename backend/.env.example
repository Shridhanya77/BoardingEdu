# ============================================================
# BoardingEdu Backend - Environment Template
#
# COPY THIS FILE TO `.env` IN THE SAME FOLDER AND FILL IN VALUES.
# NEVER COMMIT THE REAL `.env` FILE TO VERSION CONTROL.
# ============================================================

# ---- Django Core ----
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-REPLACE_WITH_RANDOM_50_CHAR_STRING

# Set to False in production.
DEBUG=True

# Comma-separated list; use * for local development only.
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ---- PostgreSQL ----
# Local Docker / compose default:
# DATABASE_URL=postgres://postgres:postgres123@localhost:5432/boardingedu
# Render: use the PostgreSQL Internal Database URL from the Render database page.
# External hosts ending in .render.com turn SSL on automatically.
DATABASE_URL=
DATABASE_SSL_REQUIRE=

# Legacy keys (unused when DATABASE_URL is set)
DB_NAME=boardingedu
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Redis (Cache backend + Celery Broker / Result Backend) ----
# Redis DB 0 for cache and celery. For production, separate DB numbers.
REDIS_URL=redis://localhost:6379/0

# ---- Meilisearch (Full-text search engine) ----
# Host backend processes use localhost; backend containers should use the
# Compose service host (http://meilisearch:7700).
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
MEILI_INDEX_UID=schools

# ---- Transactional email (Resend) ----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000
EMAIL_PROVIDER=resend
# OTP mail uses Cloudflare Email Service. Leave the token empty until the
# domain is onboarded under Email Service > Email Sending.
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_FROM=no-reply@boardingedu.com
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_BACKEND=redis

# ---- Render production checklist ----
# SECRET_KEY=          (required; generate a random key)
# DEBUG=False
# DATABASE_URL=        (Render Postgres internal connection string)
# OTP_BACKEND=database (no Redis service on the Render blueprint)
# ALLOWED_HOSTS=       (optional; RENDER_EXTERNAL_HOSTNAME is added automatically)
# CORS_ALLOWED_ORIGINS=https://boardingedu.vercel.app
# CSRF_TRUSTED_ORIGINS=https://boardingedu.vercel.app
# CLOUDFLARE_R2_*      (required for /media/schools/ image proxy)
# Store images in the bucket under schools/<filename>.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Bucket holding the school objects (keys under schools/).
CLOUDFLARE_R2_BUCKET=school-images
# Public delivery base for those objects. Must end in /schools (the R2 object
# key prefix), e.g. https://pub-<bucket-id>.r2.dev/schools. Leave blank to
# disable direct public URLs.
CLOUDFLARE_R2_PUBLIC_BASE=

# Razorpay. Leave blank until the live or test keys are issued.
# A school subscription starts only after the payment signature or webhook is verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMS_API_URL=
SMS_API_KEY=

# ---- CORS (Next.js Frontend Origins) ----
# Include the exact Vercel production origin; separate additional origins with commas.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
# Optional regexes for a controlled set of preview deployments, comma-separated.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-project-[a-z0-9-]+\\.vercel\\.app$
